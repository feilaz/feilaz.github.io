{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "npx --yes serve@14 out -l 3100 --no-clipboard",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/model.test.mjs",
    "check:export": "python3 scripts/check-export.py",
    "verify": "npm run lint && npm test && npm run check:contrast && npm run build && npm run check:export",
    "preview": "npm run build && npm start",
    "check:contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "motion": "13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
